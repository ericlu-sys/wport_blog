---
import type { GetStaticPaths } from "astro";
import ArchivePage from "@/components/ArchivePage.astro";
import { localeFromPathPrefix, nonDefaultPathPrefixes } from "@/i18n/locales";
import { getPostsByLocale } from "@/lib/posts";
import { ARCHIVE_PAGE_SIZE } from "@/lib/archive";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const paths = [];
  for (const lang of nonDefaultPathPrefixes) {
    const locale = localeFromPathPrefix(lang);
    const posts = await getPostsByLocale(locale);
    paths.push(...paginate(posts, { pageSize: ARCHIVE_PAGE_SIZE, params: { lang }, props: { locale } }));
  }
  return paths;
};

const { page, locale } = Astro.props;
---

<ArchivePage locale={locale} page={page} />
