---
import type { GetStaticPaths } from "astro";
import ArchivePage from "@/components/ArchivePage.astro";
import { defaultLocale } from "@/i18n/locales";
import { getPostsByLocale } from "@/lib/posts";
import { ARCHIVE_PAGE_SIZE } from "@/lib/archive";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getPostsByLocale(defaultLocale);
  return paginate(posts, { pageSize: ARCHIVE_PAGE_SIZE });
};

const { page } = Astro.props;
---

<ArchivePage locale={defaultLocale} page={page} />
