---
/**
 * The shared post collection used by the archive and by the tag / topic hubs.
 *
 * One set of markup renders both views: the default is the thumbnail grid, and
 * `<html data-posts-view="list">` (set by ViewToggle, restored in BlogLayout's
 * head so there is no flash) collapses the same cards into a compact list.
 */
import CoverImage from "@/components/CoverImage.astro";
import { getPostViews, formatPostViews } from "@/lib/post-views";
import { defaultLocale, type Locale } from "@/i18n/locales";
import { dateLocaleFor, localizedPath } from "@/i18n/utils";
import { translateTag } from "@/i18n/tags";
import { viewsKeyForPost, type PostMeta } from "@/lib/posts";

interface Props {
  locale?: Locale;
  posts: PostMeta[];
  /** DOM id for the list, used by the archive search script. */
  id?: string;
  /** Emit data-title/description/tags so a client script can filter the items. */
  searchable?: boolean;
  /** Load the first cover eagerly (above the fold on hub pages). */
  eagerFirst?: boolean;
}

const { locale = defaultLocale, posts, id, searchable = false, eagerFirst = false } = Astro.props;

const COVER_COLORS = [
  { hue: "#E0F5F3", accent: "#56C7BB" },
  { hue: "#FEF3E2", accent: "#F59E0B" },
  { hue: "#EEF2FF", accent: "#6366F1" },
  { hue: "#FDF2F8", accent: "#EC4899" },
  { hue: "#F0FDF4", accent: "#22C55E" },
  { hue: "#FFF7ED", accent: "#F97316" },
];

const withBase = (path: string) => localizedPath(locale, path);
---

<ul class="card-grid post-collection" id={id}>
  {
    posts.map((meta, i) => {
      const post = meta.entry;
      const cover = COVER_COLORS[i % COVER_COLORS.length];
      const tags = post.data.tags ?? [];
      const views = getPostViews(viewsKeyForPost(meta));
      return (
        <li
          class="post-card-item"
          data-title={searchable ? post.data.title : undefined}
          data-description={searchable ? post.data.description : undefined}
          data-tags={searchable ? tags.join(",") : undefined}
        >
          <a href={withBase(`/posts/${meta.baseSlug}/`)} class="card" data-post-id={meta.baseSlug}>
            <div class="card-cover" style={`background: ${cover.hue};`}>
              {post.data.cover ? (
                <CoverImage
                  src={post.data.cover}
                  alt={`${post.data.title} cover`}
                  class="card-cover-image"
                  loading={eagerFirst && i === 0 ? "eager" : "lazy"}
                />
              ) : (
                <>
                  <div class="card-cover-shape1" style={`background: ${cover.accent};`} />
                  <div class="card-cover-shape2" style={`background: ${cover.accent};`} />
                  <div class="card-cover-label" style={`color: ${cover.accent};`}>
                    wport
                  </div>
                </>
              )}
            </div>
            <div class="card-body">
              {tags.length > 0 && (
                <div class="card-tags">
                  {tags.slice(0, 4).map((tag: string) => (
                    <span class="tag">{translateTag(locale, tag)}</span>
                  ))}
                </div>
              )}
              <div class="card-title">{post.data.title}</div>
              <div class="card-excerpt">{post.data.description}</div>
              <div class="card-footer">
                {views > 0 && <span class="card-views">{formatPostViews(views)}</span>}
                <span class="card-date">
                  {post.data.publishDate.toLocaleDateString(dateLocaleFor(locale), {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </span>
              </div>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style is:global>
  /* ─── Grid view (default) ───────────────────────────────────── */
  .card-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .card-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-page);
    border-radius: 12px;
    border: 1px solid #e8e8e8;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow 180ms ease,
      transform 180ms ease,
      background-color 180ms ease;
  }

  .card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.09);
    transform: translateY(-2px);
  }

  .card-cover {
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .card-cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-cover-shape1 {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    opacity: 0.18;
    position: absolute;
    top: 28px;
    left: 28px;
  }

  .card-cover-shape2 {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    opacity: 0.25;
    position: absolute;
    bottom: 20px;
    right: 36px;
  }

  .card-cover-label {
    font-size: 36px;
    font-weight: 700;
    opacity: 0.22;
    user-select: none;
    letter-spacing: -2px;
  }

  .card-body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 11px;
    font-weight: 500;
    color: var(--color-primary);
    background: var(--bg-tag);
    border-radius: 999px;
    padding: 2px 8px;
  }

  .card-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--fg-heading);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(1.4em * 2);
  }

  .card-excerpt {
    font-size: 13.5px;
    color: var(--fg-meta);
    line-height: 1.65;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    padding-top: 8px;
    border-top: 1px solid var(--bg-code);
  }

  .card-date {
    font-size: 12px;
    color: var(--color-text-faint);
  }

  .post-card-item[hidden] {
    display: none;
  }

  /* ─── List view ─────────────────────────────────────────────────
     Same DOM, flattened: the card loses its frame and turns into a row
     with a small thumbnail, so a long tag hub scans in one column. */
  :root[data-posts-view="list"] .post-collection {
    display: block;
    border-top: 1px solid var(--bg-code);
  }

  :root[data-posts-view="list"] .post-collection .card {
    flex-direction: row;
    align-items: flex-start;
    gap: 16px;
    height: auto;
    border: none;
    border-bottom: 1px solid var(--bg-code);
    border-radius: 0;
    padding: 16px 4px;
    background: transparent;
  }

  :root[data-posts-view="list"] .post-collection .card:hover {
    box-shadow: none;
    transform: none;
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
  }

  :root[data-posts-view="list"] .post-collection .card:hover .card-title {
    color: var(--color-primary-hover, var(--color-primary));
  }

  :root[data-posts-view="list"] .post-collection .card-cover {
    flex: 0 0 auto;
    width: 116px;
    height: 78px;
    border-radius: 8px;
  }

  :root[data-posts-view="list"] .post-collection .card-cover-shape1 {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    top: 12px;
    left: 12px;
  }

  :root[data-posts-view="list"] .post-collection .card-cover-shape2 {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    bottom: 10px;
    right: 14px;
  }

  :root[data-posts-view="list"] .post-collection .card-cover-label {
    font-size: 20px;
    letter-spacing: -1px;
  }

  :root[data-posts-view="list"] .post-collection .card-body {
    padding: 0;
    gap: 6px;
  }

  :root[data-posts-view="list"] .post-collection .card-title {
    order: -1;
    font-size: 17px;
    min-height: 0;
    -webkit-line-clamp: 2;
  }

  :root[data-posts-view="list"] .post-collection .card-excerpt {
    flex: 0 1 auto;
    -webkit-line-clamp: 2;
  }

  :root[data-posts-view="list"] .post-collection .card-tags {
    order: 1;
  }

  :root[data-posts-view="list"] .post-collection .card-footer {
    order: 2;
    padding-top: 2px;
    border-top: none;
  }

  @media (max-width: 640px) {
    :root[data-posts-view="list"] .post-collection .card {
      gap: 12px;
      padding: 14px 2px;
    }

    :root[data-posts-view="list"] .post-collection .card-cover {
      width: 84px;
      height: 60px;
    }

    :root[data-posts-view="list"] .post-collection .card-excerpt {
      display: none;
    }

    :root[data-posts-view="list"] .post-collection .card-tags {
      display: none;
    }
  }
</style>

<script>
  import { applyReadMarkers } from "@/lib/read-markers";
  applyReadMarkers();
</script>
