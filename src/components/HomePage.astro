---
import BlogLayout from "@/layouts/BlogLayout.astro";
import Topbar from "@/components/Topbar.astro";
import CoverImage from "@/components/CoverImage.astro";
import HomeBento from "@/components/HomeBento.astro";
import SiteImage from "@/components/SiteImage.astro";
import { getCoverImageUrls } from "@/lib/cover-image";
import { HOME_CATEGORIES } from "@/lib/home-categories";
import { getPostViews, formatPostViews } from "@/lib/post-views";
import { defaultLocale, type Locale } from "@/i18n/locales";
import { dateLocaleFor, localizedPath, t } from "@/i18n/utils";
import { translateTag } from "@/i18n/tags";
import { getLanguageSwitcherHrefs, getPostsByLocale, viewsKeyForPost } from "@/lib/posts";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

const postsMeta = await getPostsByLocale(locale);
const sorted = postsMeta.map((p) => p.entry);
const featured = postsMeta.filter((p) => p.entry.data.featured).slice(0, 3);
const popularMeta = featured.length > 0 ? featured : postsMeta.slice(0, 3);
const popular = popularMeta;

const languageHrefs = await getLanguageSwitcherHrefs(locale, { page: "home" });

const COVER_COLORS = [
  { hue: "#E0F5F3", accent: "#56C7BB" },
  { hue: "#FEF3E2", accent: "#F59E0B" },
  { hue: "#EEF2FF", accent: "#6366F1" },
  { hue: "#FDF2F8", accent: "#EC4899" },
  { hue: "#F0FDF4", accent: "#22C55E" },
  { hue: "#FFF7ED", accent: "#F97316" },
];
const withBase = (path: string) => localizedPath(locale, path);

const lcpBentoCover = getCoverImageUrls(HOME_CATEGORIES[0].coverImage, "bento");
const lcpCoverSource = popular[0]?.entry.data.cover;
const lcpCover = lcpCoverSource ? getCoverImageUrls(lcpCoverSource, "card") : undefined;
---

<BlogLayout
  title={t(locale, "home.title")}
  description={t(locale, "home.description")}
  locale={locale}
  alternatePath="/"
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={lcpBentoCover.default}
    imagesrcset={lcpBentoCover.srcset}
    imagesizes={lcpBentoCover.sizes}
    fetchpriority="high"
  />
  {
    lcpCover && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={lcpCover.default}
        imagesrcset={lcpCover.srcset}
        imagesizes={lcpCover.sizes}
      />
    )
  }
  <Topbar currentPage="home" locale={locale} languageHrefs={languageHrefs} />

  <main>
    <!-- HERO -->
    <section class="hero-section">
      <div class="hero-inner">
        <div class="hero-text">
          <div class="hero-badge">
            <span class="hero-badge-dot"></span>
            {t(locale, "home.badge")}
          </div>
          <h1 class="hero-h1">
            {t(locale, "home.h1.line1")}<br />{t(locale, "home.h1.line2")}
          </h1>
          <h2 class="hero-h2">
            {t(locale, "home.h2")}
          </h2>
          <div class="hero-ctas">
            <a href={withBase("/archive")} class="btn-primary">{t(locale, "home.cta.archive")}</a>
            <a href="#popular" class="btn-secondary">{t(locale, "home.cta.popular")}</a>
          </div>
        </div>
        <div class="hero-art-wrap">
          <div class="hero-figure">
            <SiteImage
              src="/mascot-graduation.png"
              alt=""
              context="hero"
              class="hero-mascot hero-mascot--graduation"
              media="(min-width: 769px)"
              width={832}
              height={832}
              loading="eager"
              fetchpriority="low"
            />
            <SiteImage
              src="/mascot-cooperation.png"
              alt=""
              context="hero"
              class="hero-mascot hero-mascot--cooperation"
              media="(min-width: 769px)"
              width={832}
              height={832}
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <HomeBento posts={sorted} withBase={withBase} locale={locale} />

    <!-- POPULAR ARTICLES -->
    <section id="popular" class="popular-section">
      <div class="popular-inner">
        <div class="popular-header">
          <div>
            <div class="popular-label">{t(locale, "home.popular.label")}</div>
            <h2 class="popular-title">{t(locale, "home.popular.title")}</h2>
          </div>
          <a href={withBase("/archive")} class="popular-see-all">{t(locale, "home.popular.seeAll")}</a>
        </div>

        {
          popular.length === 0 ? (
            <p style="color: var(--color-text-muted); font-size: 15px;">{t(locale, "home.empty")}</p>
          ) : (
            <ul class="card-grid">
              {popular.map((meta, i) => {
                const post = meta.entry;
                const cover = COVER_COLORS[i % COVER_COLORS.length];
                return (
                  <li>
                    <a href={withBase(`/posts/${meta.baseSlug}`)} class="card" data-post-id={meta.baseSlug}>
                      <div class="card-cover" style={`background: ${cover.hue};`}>
                        {post.data.cover ? (
                          <CoverImage
                            src={post.data.cover}
                            alt={`${post.data.title} cover`}
                            class="card-cover-image"
                            loading={i === 0 ? "eager" : "lazy"}
                            fetchpriority={i === 0 ? "high" : "auto"}
                          />
                        ) : (
                          <>
                            <div class="card-cover-shape1" style={`background: ${cover.accent};`} />
                            <div class="card-cover-shape2" style={`background: ${cover.accent};`} />
                            <div class="card-cover-label" style={`color: ${cover.accent};`}>
                              wport
                            </div>
                          </>
                        )}
                      </div>
                      <div class="card-body">
                        {post.data.tags && post.data.tags.length > 0 && (
                          <div class="card-tags">
                            {post.data.tags.slice(0, 4).map((tag: string) => (
                              <span class="tag">{translateTag(locale, tag)}</span>
                            ))}
                          </div>
                        )}
                        <div class="card-title">{post.data.title}</div>
                        <div class="card-excerpt">{post.data.description}</div>
                        <div class="card-footer">
                          {(() => {
                            const views = getPostViews(viewsKeyForPost(meta));
                            return views > 0 ? <span class="card-views">{formatPostViews(views)}</span> : null;
                          })()}
                          <span class="card-date">
                            {post.data.publishDate.toLocaleDateString(dateLocaleFor(locale), {
                              year: "numeric",
                              month: "long",
                              day: "numeric",
                            })}
                          </span>
                        </div>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          )
        }
      </div>
    </section>

    <!--
      FULL INDEX — every post, one hop from the home page.
      The home page is the most frequently crawled URL in this section, but it
      only linked the three featured posts; everything else sat behind
      /archive/, which Googlebot visits far less often. Listing all posts here
      gives each one a link from the page Google actually comes back to.
    -->
    <section class="all-posts-section">
      <div class="all-posts-inner">
        <h2 class="all-posts-title">{t(locale, "nav.archive")}</h2>
        {
          sorted.length === 0 ? (
            <p class="all-posts-empty">{t(locale, "home.empty")}</p>
          ) : (
            <ul class="all-posts-list">
              {postsMeta.map((meta) => (
                <li>
                  <a href={withBase(`/posts/${meta.baseSlug}`)} class="all-posts-link">
                    <span class="all-posts-link-title">{meta.entry.data.title}</span>
                    <time datetime={meta.entry.data.publishDate.toISOString()} class="all-posts-date">
                      {meta.entry.data.publishDate.toLocaleDateString(dateLocaleFor(locale), {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
  </main>
</BlogLayout>

<style is:global>
  /* Hero */
  .hero-section {
    background: linear-gradient(180deg, #f8fcfb 0%, #fff 100%);
    border-bottom: 1px solid #f0f0f0;
  }
  .hero-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 64px 24px 72px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #0d7c70;
    background: #eaf8f7;
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: 20px;
  }
  .hero-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0d7c70;
    flex-shrink: 0;
  }
  .hero-h1 {
    font-size: 42px;
    font-weight: 700;
    color: #2e2e2e;
    line-height: 1.25;
    margin-bottom: 18px;
    letter-spacing: -0.5px;
    font-family: "PingFang TC", "Microsoft JhengHei", Arial, sans-serif;
  }
  .hero-h2 {
    font-size: 16px;
    font-weight: 400;
    color: #5d5d5d;
    line-height: 1.75;
    margin-bottom: 28px;
    font-family: "PingFang TC", "Microsoft JhengHei", Arial, sans-serif;
  }
  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: #0d7c70;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 12px 22px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background 150ms ease;
    font-family: "PingFang TC", "Microsoft JhengHei", Arial, sans-serif;
    display: inline-block;
  }
  .btn-primary:hover {
    background: #0a6a60;
  }
  .btn-secondary {
    background: #fff;
    color: #5d5d5d;
    border: 1px solid #d7d7d7;
    border-radius: 8px;
    padding: 12px 22px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 150ms ease,
      color 150ms ease;
    font-family: "PingFang TC", "Microsoft JhengHei", Arial, sans-serif;
    display: inline-block;
  }
  .btn-secondary:hover {
    border-color: #0d7c70;
    color: #0d7c70;
  }

  .hero-art-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hero-figure {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 1 / 1;
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 20px;
    background: radial-gradient(circle at 50% 45%, #eaf8f7 0%, rgba(248, 247, 247, 0) 68%);
    animation: heroFloat 6s ease-in-out infinite;
    transform-origin: center center;
    filter: drop-shadow(0 16px 32px rgba(86, 199, 187, 0.15));
  }
  .hero-mascot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    animation: heroCrossfade 8s ease-in-out infinite;
  }
  .hero-mascot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .hero-mascot--cooperation {
    animation-delay: 4s;
  }
  @keyframes heroFloat {
    0%,
    100% {
      transform: translateY(0px) rotate(-0.5deg);
    }
    35% {
      transform: translateY(-12px) rotate(0.6deg);
    }
    70% {
      transform: translateY(-5px) rotate(-0.3deg);
    }
  }
  @keyframes heroCrossfade {
    0%,
    40% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-figure,
    .hero-mascot {
      animation: none;
    }
    .hero-mascot--graduation {
      opacity: 1;
    }
    .hero-mascot--cooperation {
      opacity: 0;
    }
  }

  /* Popular section */
  .popular-section {
    max-width: 1080px;
    margin: 0 auto;
    padding: 72px 24px 80px;
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }
  .popular-inner {
    width: 100%;
  }
  .popular-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 32px;
  }
  .popular-label {
    font-size: 12px;
    font-weight: 600;
    color: #0d7c70;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
    font-family: "PingFang TC", "Microsoft JhengHei", Arial, sans-serif;
  }
  .popular-title {
    font-size: 28px;
    font-weight: 700;
    color: #2e2e2e;
    line-height: 1.3;
    font-family: "PingFang TC", "Microsoft JhengHei", Arial, sans-serif;
  }
  .popular-see-all {
    color: #0d7c70;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color 150ms ease;
    font-family: "PingFang TC", "Microsoft JhengHei", Arial, sans-serif;
  }
  .popular-see-all:hover {
    color: #0a6a60;
  }

  /* Cards (shared with archive) */
  .card-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .card-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border-radius: 12px;
    border: 1px solid #e8e8e8;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow 180ms ease,
      transform 180ms ease;
  }
  .card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.09);
    transform: translateY(-2px);
  }
  .card-cover {
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .card-cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-cover-shape1 {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    opacity: 0.18;
    position: absolute;
    top: 28px;
    left: 28px;
  }
  .card-cover-shape2 {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    opacity: 0.25;
    position: absolute;
    bottom: 20px;
    right: 36px;
  }
  .card-cover-label {
    font-size: 36px;
    font-weight: 700;
    opacity: 0.22;
    user-select: none;
    letter-spacing: -2px;
  }
  .card-body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    font-size: 11px;
    font-weight: 500;
    color: #0d7c70;
    background: #eaf8f7;
    border-radius: 999px;
    padding: 2px 8px;
  }
  .card-title {
    font-size: 16px;
    font-weight: 700;
    color: #2e2e2e;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(1.4em * 2);
  }
  .card-excerpt {
    font-size: 13.5px;
    color: var(--color-text-muted);
    line-height: 1.65;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    padding-top: 8px;
    border-top: 1px solid #f0f0f0;
  }
  .card-date {
    font-size: 12px;
    color: var(--color-text-faint);
  }

  /* Full index */
  .all-posts-section {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px 80px;
    content-visibility: auto;
    contain-intrinsic-size: auto 800px;
  }
  .all-posts-inner {
    border-top: 1px solid #f0f0f0;
    padding-top: 40px;
  }
  .all-posts-title {
    font-size: 20px;
    font-weight: 700;
    color: #2e2e2e;
    line-height: 1.3;
    margin-bottom: 20px;
    font-family: "PingFang TC", "Microsoft JhengHei", Arial, sans-serif;
  }
  .all-posts-empty {
    color: var(--color-text-muted);
    font-size: 15px;
  }
  .all-posts-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px 32px;
  }
  .all-posts-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid #f6f6f6;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .all-posts-link-title {
    font-size: 14px;
    color: #444;
    line-height: 1.5;
  }
  .all-posts-link:hover .all-posts-link-title {
    color: #0d7c70;
  }
  .all-posts-date {
    flex: none;
    font-size: 12px;
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 768px) {
    .all-posts-list {
      grid-template-columns: 1fr;
    }
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-art-wrap {
      display: none;
    }
    .hero-h1 {
      font-size: 30px;
    }
  }
</style>

<script>
  import { applyReadMarkers } from "@/lib/read-markers";
  applyReadMarkers();
</script>
